# Copy to deploy/.env and set real values. Never commit deploy/.env.
# Generate secrets with e.g.: openssl rand -base64 48

# HMAC secret your login service signs JWTs with (auth.jwt_secret_env).
JWT_SECRET=change-me
# Named keys for service-to-service calls: name:key,name:key
SERVICE_API_KEYS=billing-svc:change-me-1,reports:change-me-2
# Password for the Valkey rate-limit store (used by both containers).
VALKEY_PASSWORD=change-me
