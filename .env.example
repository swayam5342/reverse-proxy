# Copy to .env (or set in your deployment secrets manager) and fill in real
# values. Never commit the real .env file.

GATEWAY_CONFIG=config.yaml
GATEWAY_ADDR=:8080

JWT_SECRET=change-me
# Alternative to JWT_SECRET for jwt_public_key_env: a PEM public key or cert.
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
# Comma-separated name:key pairs; the name identifies the caller (X-Auth-Subject).
ORDERS_API_KEYS=billing-svc:change-me-key-1,reports:change-me-key-2
ORDERS_SIGNING_SECRET=change-me
